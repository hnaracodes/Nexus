{
  "name": "nexus",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "protocol:build": "npm run build -w @syncode/protocol",
    "protocol:watch": "npm run watch -w @syncode/protocol",
    "dev": "npm run dev -w @syncode/server",
    "build": "npm run build -w @syncode/server",
    "typecheck": "npm run typecheck -w @syncode/server",
    "start": "npm run start -w @syncode/server",
    "test": "npm run test -w @syncode/server",
    "test:watch": "npm run test:watch -w @syncode/server",
    "build:client": "npm run build -w @syncode/web",
    "test:client": "npm run test -w @syncode/web",
    "test:all": "npm test && npm run test:client && npm run test:desktop && npm run test:install",
    "verify": "npm run typecheck && npm run typecheck:desktop && npm run build && npm run build:client && npm run build:desktop && npm test && npm run test:client && npm run test:desktop && npm run test:install",
    "typecheck:desktop": "npm run typecheck -w @syncode/desktop",
    "build:desktop": "npm run build -w @syncode/desktop",
    "test:desktop": "npm run test -w @syncode/desktop",
    "test:install": "node scripts/install.test.mjs",
    "clean": "node -e \"const{rmSync}=require('fs');for(const d of ['apps/server/dist','apps/web/dist','apps/desktop/dist','packages/protocol/dist'])rmSync(d,{recursive:true,force:true})\"",
    "verify:clean": "npm run clean && npm run verify"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
